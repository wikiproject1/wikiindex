{
  "name": "wikiindex",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:nuxt\" \"npm:dev:api\"",
    "dev:nuxt": "nuxt dev --port 4445",
    "dev:api": "api/venv/bin/uvicorn api.main:app --port 8000 --reload --host 0.0.0.0",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.87",
    "@iconify-json/simple-icons": "^1.2.68",
    "@nuxt/ui": "^4.4.0",
    "nuxt": "^4.3.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.13.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.4",
    "wait-on": "^9.0.3"
  },
  "packageManager": "pnpm@10.28.2"
}
